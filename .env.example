APP_ENV=development
APP_VERSION=dev
PUBLIC_BASE_URL=http://localhost:8080
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=65536
HTTP_MAX_HEADER_BYTES=16384
HTTP_TRUSTED_PROXIES=127.0.0.1,::1

JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
PASSWORD_RESET_TTL=30m

MYSQL_DSN=short_url:change-me@tcp(127.0.0.1:3306)/short_url?parseTime=true&loc=UTC&charset=utf8mb4&collation=utf8mb4_unicode_ci
MYSQL_MAX_OPEN_CONNS=50
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=1h

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=50
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=3s
REDIS_READ_TIMEOUT=2s
REDIS_WRITE_TIMEOUT=2s

ANALYTICS_HASH_SECRET=replace-with-at-least-32-random-bytes
CLICK_STREAM=shorturl:clicks
CLICK_CONSUMER_GROUP=shorturl-analytics

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_REGISTER_WINDOW=1h
RATE_LIMIT_REGISTER_FAIL_CLOSED=true
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW=5m
RATE_LIMIT_LOGIN_FAIL_CLOSED=true
RATE_LIMIT_REFRESH_LIMIT=30
RATE_LIMIT_REFRESH_WINDOW=1m
RATE_LIMIT_REFRESH_FAIL_CLOSED=true
RATE_LIMIT_API_LIMIT=120
RATE_LIMIT_API_WINDOW=1m
RATE_LIMIT_API_FAIL_CLOSED=false
RATE_LIMIT_CREATE_LINK_LIMIT=30
RATE_LIMIT_CREATE_LINK_WINDOW=1m
RATE_LIMIT_CREATE_LINK_FAIL_CLOSED=false
RATE_LIMIT_REDIRECT_LIMIT=600
RATE_LIMIT_REDIRECT_WINDOW=1m
RATE_LIMIT_REDIRECT_FAIL_CLOSED=false
RATE_LIMIT_TRIAL_CREATE_LIMIT=10
RATE_LIMIT_TRIAL_CREATE_WINDOW=1h
RATE_LIMIT_TRIAL_CREATE_FAIL_CLOSED=true

IDEMPOTENCY_TTL=24h

TRIAL_SESSION_TTL=24h
TRIAL_LINK_LIMIT=3
TRIAL_CLEANUP_INTERVAL=10m

DOMAIN_VERIFY_MODE=mock
CUSTOM_DOMAIN_CNAME=links.localhost
